# Copy to .env.local (or set in your host's dashboard) and fill in.

# Public URL of the site, no trailing slash. Used for the X callback and link previews.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Connect X (developer.x.com: create an app with OAuth 2.0, type "Web App").
# Use the OAuth 2.0 Client ID and Client Secret, not the API Key/Secret.
# Register a callback per origin, e.g.
#   http://localhost:3000/api/auth/x/callback
#   https://yourdomain.com/api/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# REQUIRED in production. Long random string that signs the session and progress cookies.
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# The pinned post people like, repost and reply to (tag a friend).
NEXT_PUBLIC_PINNED_POST=https://x.com/bibbleshq/status/...

# Password for the CSV export at /api/admin/export?key=...
# The export only works once a database (Upstash) is added. Without one,
# progress is kept in each visitor's browser.
ADMIN_KEY=
